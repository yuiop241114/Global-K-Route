PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

DB_URL=jdbc:mysql://your-tidb-host:4000/your_database?useSSL=true&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password

REDIS_REST_URL=https://your-upstash-instance.upstash.io
REDIS_REST_TOKEN=your_upstash_token

TOUR_API_KEY=your_tour_api_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

FRONTEND_BASE_URL=http://localhost:3000
AUTH_SECURE_COOKIE=false
AUTH_SESSION_DAYS=7
PASSWORD_RESET_MINUTES=30

MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=verified-sender@example.com
MAILJET_FROM_NAME=Global K-Route
